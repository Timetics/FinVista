# Supabase project connection.
#
# Copy this file to `.env.local` and fill in the values from
# Supabase Dashboard -> Project Settings -> API.
#
#   cp .env.example .env.local
#
# `.env.local` is gitignored -- never commit real keys.

# Project URL, e.g. https://<project-ref>.supabase.co
VITE_SUPABASE_URL=

# Publishable / anon key. This key is safe to ship in the browser -- access is
# controlled by the Row Level Security policies on the `transactions` table.
VITE_SUPABASE_ANON_KEY=
